<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <TextView
        android:id="@+id/tv_lab_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lab_label"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_responsive"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:gravity="center"
        android:background="@color/white"
        android:paddingTop="20dp"
        android:paddingBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_block_this"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/block_red"
            android:text="@string/block_this"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_block_is"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/block_blue"
            android:text="@string/block_is"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_block_my"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/block_purple"
            android:text="@string/block_my"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_block_first"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/block_yellow"
            android:text="@string/block_first"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_app_label"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/app_label"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/btn_change"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_change"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:background="@drawable/btn_change_bg" />

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/btn_cancel"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:background="@drawable/btn_cancel_bg" />
    </LinearLayout>

</LinearLayout>
